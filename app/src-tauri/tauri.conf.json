{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIC CAD",
  "version": "0.1.0",
  "identifier": "vn.aic.cad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "AIC CAD", "width": 1600, "height": 960, "minWidth": 1100, "minHeight": 700 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
